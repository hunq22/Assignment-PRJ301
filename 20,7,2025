import java.util.HashMap;
import model.DBContext;

public class DepartmentDBContext extends DBContext {

    // Lấy danh sách tên nhân viên dưới quyền trưởng phòng (theo bossid)
    public ArrayList<String> getEmployeesUnderManager(int managerAid) {
        ArrayList<String> list = new ArrayList<>();
        String sql = """
            SELECT e2.ename
            FROM Account_Employee ae1
            JOIN Employee e1 ON ae1.eid = e1.eid
            JOIN Employee e2 ON e2.bossid = e1.eid
            WHERE ae1.aid = ?
        """;

        try (PreparedStatement ps = connection.prepareStatement(sql)) {
            ps.setInt(1, managerAid);
            ResultSet rs = ps.executeQuery();
            while (rs.next()) {
                list.add(rs.getString("ename"));
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return list;
    }

    // Lấy danh sách các ngày nghỉ của từng nhân viên
    public HashMap<String, ArrayList<LocalDate>> getLeaveDatesForEmployees(
            ArrayList<String> employees, LocalDate from, LocalDate to) {

        HashMap<String, ArrayList<LocalDate>> map = new HashMap<>();
        for (String emp : employees) {
            map.put(emp, new ArrayList<>());
        }

        if (employees.isEmpty()) return map;

        StringBuilder sql = new StringBuilder("""
            SELECT e.ename, r.[from], r.[to]
            FROM RequestForLeave r
            JOIN Account a ON r.createdby = a.aid
            JOIN Account_Employee ae ON a.aid = ae.aid
            JOIN Employee e ON ae.eid = e.eid
            WHERE r.status = 1
              AND e.ename IN (
        """);
        for (int i = 0; i < employees.size(); i++) {
            sql.append("?");
            if (i < employees.size() - 1) sql.append(", ");
        }
        sql.append(")");

        try (PreparedStatement ps = connection.prepareStatement(sql.toString())) {
            for (int i = 0; i < employees.size(); i++) {
                ps.setString(i + 1, employees.get(i));
            }
            ResultSet rs = ps.executeQuery();
            while (rs.next()) {
                String name = rs.getString("ename");
                LocalDate start = rs.getDate("from").toLocalDate();
                LocalDate end = rs.getDate("to").toLocalDate();
                for (LocalDate d = start; !d.isAfter(end); d = d.plusDays(1)) {
                    if (!d.isBefore(from) && !d.isAfter(to)) {
                        map.get(name).add(d);
                    }
                }
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }

        return map;
    }
}
