public ArrayList<RequestForLeave> list(int aid) {
    ArrayList<RequestForLeave> list = new ArrayList<>();
    try {
        String sql = """
            SELECT r.rid, r.title, r.[from], r.[to], r.reason, r.status, 
                   created.displayname AS createdby, processed.displayname AS processedby
            FROM RequestForLeave r
            INNER JOIN Account created ON r.createdby = created.aid
            LEFT JOIN Account processed ON r.processedby = processed.aid
            WHERE r.createdby = ? 
               OR r.createdby IN (
                   SELECT e2.aid
                   FROM Account_Employee ae1
                   JOIN Employee e1 ON ae1.eid = e1.eid
                   JOIN Employee e2 ON e2.bossid = e1.eid
                   JOIN Account_Employee ae2 ON ae2.eid = e2.eid
                   WHERE ae1.aid = ?
               )
        """;

        PreparedStatement ps = connection.prepareStatement(sql);
        ps.setInt(1, aid);
        ps.setInt(2, aid);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {
            RequestForLeave r = new RequestForLeave();
            r.setRid(rs.getInt("rid"));
            r.setTitle(rs.getString("title"));
            r.setFrom(rs.getDate("from"));
            r.setTo(rs.getDate("to"));
            r.setReason(rs.getString("reason"));
            r.setStatus(rs.getInt("status"));

            Account createdBy = new Account();
            createdBy.setDisplayName(rs.getString("createdby"));
            r.setCreatedBy(createdBy);

            Account processedBy = new Account();
            processedBy.setDisplayName(rs.getString("processedby"));
            r.setProcessedBy(processedBy);

            list.add(r);
        }
    } catch (SQLException e) {
        e.printStackTrace();
    }
    return list;
}
